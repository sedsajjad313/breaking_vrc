{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "vercel-xhttp-relay",
  "functions": {
    "api/index.js": {
      "runtime": "edge"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "trailingSlash": false
}
